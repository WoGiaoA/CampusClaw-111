# Copy via scripts/init-env.ps1 to generate local secrets without overwriting.
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_KEY=
SESSION_COOKIE_SECURE=false
SEED_TEACHER_A_PASSWORD=
SEED_TEACHER_B_PASSWORD=
SEED_STUDENT_A1_PASSWORD=
SEED_STUDENT_B1_PASSWORD=
WEB_PORT=8080
# Default production: demo registration/reset forbidden. Enable both explicitly for local demo use.
APP_ENV=production
DEMO_MODE=false
# Public copy of Docker Official Images; avoids Docker Hub auth endpoint failures.
IMAGE_REGISTRY=public.ecr.aws/docker/library

# OpenAI-compatible base URLs include /v1 (or gateway API prefix).
# Fill with provider-confirmed model and dimension; no invented defaults.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
MCP_SERVER_TOKEN=
# Base64 of an independent 32-byte random key. Keep stable across restarts.
MCP_CREDENTIAL_KEY=
# Optional shared Qdrant key, never exposed to the browser.
QDRANT_API_KEY=
